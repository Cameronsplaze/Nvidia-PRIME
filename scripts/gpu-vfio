#!/bin/bash
set -euo pipefail

# GPU PCIe address
GPU="01:00.0"

fail() {
    echo "$1" >&2
    exit 1
}

info() {
    echo "$1"
}

notify() {
    local icon="$1" message="$2"
    sudo -u "#$UID_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_USER/bus" \
        notify-send -i "$icon" -t 3000 "GPU Driver" "$message"
}

safe_modprobe() {
    local output
    if ! output=$(modprobe "$@" 2>&1); then
        # amdgpu keeping a module busy is expected here, anything else is fatal
        echo "$output" | grep -q "Module amdgpu is in use" || fail "$output"
    fi
}

# fuser goes blind once the detach removes /dev/dri/by-path, the refcount does not
module_refcnt() {
    cat "/sys/module/$1/refcnt" 2>/dev/null || echo 0
}
wait_for_modules_released() {
    local attempt
    for (( attempt = 0; attempt < 20; attempt++ )); do
        if [[ "$(module_refcnt nvidia_drm)" == 0 && "$(module_refcnt nvidia_uvm)" == 0 ]]; then
            return
        fi
        sleep "0.2"
    done
}

if [[ "$EUID" -ne 0 ]]; then
    fail "root permissions are required"
fi

UID_USER=$(id -u "${SUDO_USER:-1000}" 2>/dev/null || echo 1000)
driver=$(lspci -nnk -s "$GPU" | awk -F': ' '/Kernel driver in use/ {print $2}')

[[ -z "${driver:-}" ]] && fail "Could not find driver in use for $GPU"

if [[ "$driver" == "vfio-pci" ]]; then
    info "vfio-pci is already loaded"
    exit 0
fi

systemctl stop nvidia-persistenced
# Dynamic Boost daemon, laptop-only so it is not installed everywhere
systemctl stop nvidia-powerd 2>/dev/null || true
nvidia-smi -pm 0

# Lets NVIDIA let go of the GPU when you have external monitors attached to it
udevadm trigger --action=remove "/sys/bus/pci/devices/0000:$GPU"

if ! gpu-nvidia-processes; then
    notify dialog-error "NVIDIA GPU is in use, cannot switch driver"
    fail "NVIDIA GPU is in use, can not switch driver"
fi

wait_for_modules_released

safe_modprobe -r nvidia_uvm
safe_modprobe -r nvidia_drm
safe_modprobe -r nvidia_modeset
safe_modprobe -r nvidia
safe_modprobe -r i2c_nvidia_gpu

safe_modprobe vfio
safe_modprobe vfio_pci
safe_modprobe vfio_iommu_type1

gpu-check
info "Loaded vfio-pci driver successfuly"
notify emblem-success "Switched GPU driver to VFIO"
exit 0
